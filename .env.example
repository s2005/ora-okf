# Oracle connection settings for ora-okf.
#
# Copy this file, fill it in, and keep the copy OUT of version control
# (.gitignore already excludes *.env except this example).
#
# Any value left blank here is read from the process environment instead, so a
# secret can stay out of the file entirely:
#
#     export DB_PASSWORD='...'
#     ora-okf --env-file oracle.env --okf-dir out/okf

DB_USER=APP_OWNER
DB_PASSWORD=

# Either set DB_DSN directly...
DB_DSN=db.example.com:1521/ORCLPDB1

# ...or give the parts and let ora-okf assemble it (DB_DSN wins if both are set).
# DB_HOST=db.example.com
# DB_PORT=1521
# DB_SERVICE=ORCLPDB1

# Schema to export. Defaults to DB_USER, so set this only when the account
# reads a different schema through granted privileges.
# SCHEMA=APP_OWNER
