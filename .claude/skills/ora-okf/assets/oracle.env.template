# Oracle connection settings for ora-okf.
#
# Copy this next to where you run ora-okf, fill it in, and keep it out of
# version control. Any value left blank is read from the process environment
# instead, so the password can stay out of the file entirely:
#
#     export DB_PASSWORD='...'
#     uvx --from git+https://github.com/s2005/ora-okf.git ora-okf \
#         --env-file oracle.env --okf-dir out/okf

DB_USER=APP_OWNER
DB_PASSWORD=

# Either set DB_DSN directly...
DB_DSN=db.example.com:1521/ORCLPDB1

# ...or give the parts and let ora-okf assemble it (DB_DSN wins if both are set).
# DB_HOST=db.example.com
# DB_PORT=1521
# DB_SERVICE=ORCLPDB1

# Schema to export. Defaults to DB_USER, so set this only when the account
# reads a different schema through granted privileges.
# SCHEMA=APP_OWNER
